<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- 仅 debug 构建：adb broadcast 安装运行时界面插件 -->
        <receiver
            android:name=".uiplugin.DevUiPluginInstallerReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.stupidtree.hitax.DEV_INSTALL_UI_PLUGIN" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".uiplugin.DevUiPluginOpenReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.stupidtree.hitax.DEV_OPEN_UI_PLUGIN" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".market.DevMarketReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.stupidtree.hitax.DEV_INSTALL_DEX" />
                <action android:name="com.stupidtree.hitax.DEV_UNINSTALL_DEX" />
                <action android:name="com.stupidtree.hitax.DEV_ENABLE_DEX" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".debug.DevLiteSeedReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.stupidtree.hitax.DEV_IMPORT_ICS" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".debug.DevTimetableMutationReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.stupidtree.hitax.DEV_MUTATE_TIMETABLE" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".debug.DevClassEndingReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.stupidtree.hitax.DEV_CLASS_ENDING" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
