{
  "enabled": [
    "com.stupidtree.hita.theta",
    "com.stupidtree.hitax.timetable",
    "com.stupidtree.hitax.eas",
    "com.stupidtree.hitax.resource",
    "com.stupidtree.hitax.user"
  ],
  "plugins": [
    {
      "id": "com.stupidtree.hita.theta",
      "class": "com.stupidtree.hita.theta.ThetaPlugin",
      "name": "θ 社区",
      "provides": ["hita.community"]
    },
    {
      "id": "com.stupidtree.hitax.timetable",
      "class": "com.stupidtree.hitax.plugin.HitaPlugin",
      "needsApplication": true,
      "name": "课表",
      "provides": ["hita.timetable", "hita.timetable.ui", "hita.timetable.appearance"]
    },
    {
      "id": "com.stupidtree.hitax.eas",
      "class": "com.stupidtree.hitax.eas.EasPlugin",
      "needsApplication": true,
      "name": "教务",
      "provides": [
        "hita.eas",
        "hita.eas.scores",
        "hita.eas.classrooms",
        "hita.eas.trainingPlan",
        "hita.eas.exams"
      ]
    },
    {
      "id": "com.stupidtree.hitax.resource",
      "class": "com.stupidtree.hitax.plugin.ResourcePlugin",
      "needsApplication": true,
      "name": "课程资源",
      "provides": ["hita.resource.ui", "hita.resource.data", "hita.resource.teachers"]
    },
    {
      "id": "com.stupidtree.hitax.user",
      "class": "com.stupidtree.hitax.plugin.UserPlugin",
      "needsApplication": true,
      "name": "个人主页",
      "provides": ["hita.user.ui"]
    }
  ]
}
