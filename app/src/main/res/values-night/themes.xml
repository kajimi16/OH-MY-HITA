<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/cruel_summer_primary</item>
        <item name="colorPrimaryVariant">@color/cruel_summer_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorFade">#736dfe</item>
        <item name="colorPrimaryDisabled">#77cbd4e2</item>
        <item name="backgroundColorBar">#30e7e7f2</item>
        <item name="colorSecondary">@color/cruel_summer_primary</item>
        <item name="colorSecondaryVariant">@color/cruel_summer_primary</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">#00000000</item>
        <!-- Customize your theme here. -->
        <!--        fafbff-->
        <item name="backgroundColorBottom">#FF000000</item>
        <item name="backgroundColorBottomAsTint">#bF242424</item>
        <item name="backgroundColorSecond">#FF121212</item>
        <item name="backgroundColorSecondAsTint">#6F242424</item>
        <item name="textColorPrimary">#FFffff</item>
        <item name="colorControlNormal">#44ffffff</item>
        <item name="textColorSecondary">#FF858585</item>
        <item name="colorControlDisabled">#ffE0E0E0</item>
        <item name="backgroundIconColorBottom">#33304ffe</item>

        <!--透明状态栏-->
        <item name="android:windowLightStatusBar">true</item>
    
        <item name="designCornerRadius">16dp</item>
    
        <item name="designSpacing">16dp</item>
    </style>


    <!-- 欢迎页的风格 -->
    <style name="SplashTheme" parent="AppTheme">
        <item name="android:windowBackground">@drawable/splash</item>
        <item name="android:windowFullscreen">true</item>
        <!-- <item name="android:windowIsTranslucent">true</item> -->
        <!-- 透明背景不要了 -->
    </style>


    <!--    圆角透明背景的BottomSheetDialog主题-->
    <style name="TransparentBottomSheetDialogTheme" parent="Theme.MaterialComponents.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/TransparentBottomSheetStyle</item>
    </style>

    <style name="TransparentBottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
        <item name="behavior_peekHeight">400dp</item>
    </style>

    <style name="ToolBarTheme_Light" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorButtonNormal">#FFFFFF</item>
        <item name="colorControlNormal">#FFFFFF</item>
        <item name="actionMenuTextColor">#FFFFFF</item>
        <item name="android:titleTextAppearance">@style/Toolbar_Light_TitleStyle</item>
    </style>

    <style name="Toolbar_Light_TitleStyle" parent="TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="android:textColor">#ffffff</item>
    </style>

    <style name="tab_text_appearance">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?attr/textColorPrimary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!--水波纹风格-->
    <style name="button_ripple_white">
        <item name="android:colorControlHighlight">@color/white</item>
        <item name="android:radius">24dp</item>
    </style>

    <style name="button_ripple_control">
        <item name="android:colorControlHighlight">?attr/colorControlNormal</item>
        <item name="android:radius">24dp</item>
    </style>

    <style name="button_ripple_control_large">
        <item name="android:colorControlHighlight">?attr/colorControlNormal</item>
        <item name="android:radius">32dp</item>
    </style>


    <style name="unbound_ripple_white_light">
        <item name="android:colorControlHighlight">#44FFFFFF</item>
    </style>

    <style name="button_ripple_accent_little">
        <item name="android:colorControlHighlight">?attr/colorPrimary</item>
        <item name="android:radius">16dp</item>
    </style>

    <style name="button_ripple_accent">
        <item name="android:colorControlHighlight">?attr/colorPrimary</item>
        <item name="android:radius">24dp</item>
    </style>

    <style name="button_ripple_accent_large">
        <item name="android:colorControlHighlight">?attr/colorPrimary</item>
        <item name="android:radius">32dp</item>
    </style>


    <style name="text_style_18sp_bold_white">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:fontFamily">sans-serif-black</item>
    </style>

    <style name="text_style_28sp_bold_white">
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:fontFamily">sans-serif-black</item>
    </style>

    <style name="text_style_18sp_bold_primary">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">?attr/textColorPrimary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="text_style_30sp_bold_primary">
        <item name="android:textSize">30sp</item>
        <item name="android:textColor">?attr/textColorPrimary</item>
        <item name="android:fontFamily">sans-serif-black</item>
    </style>

    <style name="AppTheme.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <style name="AppTheme.AppleGlass" parent="AppTheme">
        <item name="colorPrimary">#0A84FF</item>
        <item name="colorPrimaryVariant">#0A84FF</item>
        <item name="colorSecondary">#63E6D2</item>
        <item name="colorSecondaryVariant">#63E6D2</item>
        <item name="colorAccent">#BF5AF2</item>
        <item name="backgroundColorBottom">#99090B10</item>
        <item name="backgroundColorSecond">#B3101318</item>
        <item name="textColorPrimary">#F5F7FA</item>
        <item name="textColorSecondary">#CCD2DA</item>
        <item name="android:fontFamily">@font/inter</item>
    
        <item name="designCornerRadius">24dp</item>
    
        <item name="designSpacing">20dp</item>
    </style>
    <style name="AppTheme.Cyber" parent="AppTheme">
        <item name="colorPrimary">#22D3EE</item>
        <item name="colorPrimaryVariant">#22D3EE</item>
        <item name="colorSecondary">#A78BFA</item>
        <item name="colorSecondaryVariant">#A78BFA</item>
        <item name="colorAccent">#F472B6</item>
        <item name="backgroundColorBottom">#04050C</item>
        <item name="backgroundColorSecond">#0A0E1D</item>
        <item name="textColorPrimary">#E6EDF7</item>
        <item name="textColorSecondary">#93A0BE</item>
        <item name="android:fontFamily">@font/orbitron</item>
    
        <item name="designCornerRadius">8dp</item>
    
        <item name="designSpacing">12dp</item>
    </style>
    <style name="AppTheme.SoraCloud" parent="AppTheme">
        <item name="colorPrimary">#F06A52</item>
        <item name="colorPrimaryVariant">#F06A52</item>
        <item name="colorSecondary">#8FB2B5</item>
        <item name="colorSecondaryVariant">#8FB2B5</item>
        <item name="colorAccent">#E6B85E</item>
        <item name="backgroundColorBottom">#181714</item>
        <item name="backgroundColorSecond">#25221D</item>
        <item name="textColorPrimary">#F4ECD9</item>
        <item name="textColorSecondary">#C9BEA8</item>
        <item name="android:fontFamily">serif</item>
    
        <item name="designCornerRadius">20dp</item>
    
        <item name="designSpacing">16dp</item>
    </style>
    <style name="AppTheme.P5" parent="AppTheme">
        <item name="colorPrimary">#E60012</item>
        <item name="colorPrimaryVariant">#E60012</item>
        <item name="colorSecondary">#F5F5F5</item>
        <item name="colorSecondaryVariant">#F5F5F5</item>
        <item name="colorAccent">#FFC400</item>
        <item name="backgroundColorBottom">#0B0B0C</item>
        <item name="backgroundColorSecond">#17171A</item>
        <item name="textColorPrimary">#F5F5F5</item>
        <item name="textColorSecondary">#B9B9C0</item>
        <item name="android:fontFamily">@font/p5_title</item>
    
        <item name="designCornerRadius">4dp</item>
    
        <item name="designSpacing">8dp</item>
    </style>
    <style name="AppTheme.DeepSpace" parent="AppTheme">
        <item name="colorPrimary">#E3C878</item>
        <item name="colorPrimaryVariant">#E3C878</item>
        <item name="colorSecondary">#9B8EC4</item>
        <item name="colorSecondaryVariant">#9B8EC4</item>
        <item name="colorAccent">#C48A9B</item>
        <item name="backgroundColorBottom">#04060D</item>
        <item name="backgroundColorSecond">#0B1020</item>
        <item name="textColorPrimary">#EDEEF0</item>
        <item name="textColorSecondary">#A9B0BE</item>
        <item name="android:fontFamily">@font/space_grotesk</item>
    
        <item name="designCornerRadius">18dp</item>
    
        <item name="designSpacing">16dp</item>
    </style>
    <style name="AppTheme.Sumi" parent="AppTheme">
        <item name="colorPrimary">#E4DCCB</item>
        <item name="colorPrimaryVariant">#E4DCCB</item>
        <item name="colorSecondary">#C66A54</item>
        <item name="colorSecondaryVariant">#C66A54</item>
        <item name="colorAccent">#8A937E</item>
        <item name="backgroundColorBottom">#161512</item>
        <item name="backgroundColorSecond">#211F1B</item>
        <item name="textColorPrimary">#E9E2D2</item>
        <item name="textColorSecondary">#A79D8B</item>
        <item name="android:fontFamily">@font/sumi_title</item>
    
        <item name="designCornerRadius">10dp</item>
    
        <item name="designSpacing">14dp</item>
    </style>
</resources>
