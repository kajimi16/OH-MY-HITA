            android:theme="@style/AppTheme" />
        <activity
            android:name=".ui.eas.classroom.LiteEmptyClassroomActivity"
            android:exported="false"
            android:theme="@style/AppTheme" />
        <activity
            android:name=".ui.eas.imp.LiteImportTimetableActivity"
            android:exported="false"
            android:theme="@style/AppTheme" />
        <activity
            android:name=".ui.timetable.detail.LiteTimetableDetailActivity"
            android:exported="false"
            android:theme="@style/AppTheme" />
        <receiver
            android:name=".ui.widgets.today.LiteTodayWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.stupidtree.hitax.legacy.lite.WIDGET_REFRESH" />
                <action android:name="com.stupidtree.hita.WIDGET_EVENT_REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/lite_widget_today_info" />
        </receiver>
        <receiver
            android:name=".ui.widgets.today.LiteTodayWidgetSlim"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.stupidtree.hitax.legacy.lite.WIDGET_REFRESH" />
                <action android:name="com.stupidtree.hita.WIDGET_EVENT_REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/lite_widget_today_slim_info" />
        </receiver>
        <service
            android:name=".ui.widgets.today.LiteListWidgetService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />
    </application>
</manifest>
