            android:exported="false"
            android:theme="@style/AppTheme" />
        <activity
            android:name=".ui.profile.LiteProfileActivity"
            android:exported="false"
            android:theme="@style/AppTheme" />
        <activity
            android:name=".ui.eas.score.LiteScoreInquiryActivity"
            android:exported="false"
            android:theme="@style/AppTheme" />
        <activity
