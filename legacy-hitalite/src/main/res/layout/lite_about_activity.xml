<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/lite_about_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/lite_about_element_gradient"
        app:elevation="0dp">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:layout_width="match_parent"
            android:layout_height="420dp"
            app:layout_scrollFlags="scroll|enterAlwaysCollapsed"
            app:title=" "
            app:toolbarId="@+id/lite_about_toolbar">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="280dp"
                android:layout_gravity="center"
                android:layout_marginTop="64dp"
                android:layout_marginBottom="48dp"
                android:gravity="center"
                android:orientation="vertical"
                app:layout_collapseMode="parallax"
                app:layout_collapseParallaxMultiplier="0.8">

                <androidx.cardview.widget.CardView
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    app:cardBackgroundColor="@color/lite_about_white"
                    app:cardCornerRadius="60dp"
                    app:cardElevation="16dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:padding="8dp"
                        app:srcCompat="@drawable/lite_logo" />
                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/lite_about_app_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="24dp"
                    android:fontFamily="sans-serif-black"
                    android:textColor="@color/lite_about_white"
                    android:textSize="24sp" />

                <TextView
                    android:id="@+id/lite_about_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_margin="8dp"
                    android:text="@string/lite_about_version"
                    android:textColor="@color/lite_about_white"
                    android:textSize="16sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/lite_about_privacy_protocol"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="2dp"
                        android:background="@drawable/lite_about_element_rounded_button_bg_white"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:paddingStart="8dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="4dp"
                        android:text="@string/lite_about_agreement_entry"
                        android:textColor="@color/lite_about_white"
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/lite_about_toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:layout_marginTop="24dp"
                app:layout_collapseMode="pin"
                app:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar" />

        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="-36dp"
        android:background="@drawable/lite_about_bottom_sheet_rounded_background"
        android:overScrollMode="never"
        app:behavior_overlapTop="0dp"
        app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior">

        <TextView
            android:id="@+id/lite_about_about_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="36dp"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="24dp"
            android:autoLink="all"
            android:textColor="?attr/textColorPrimary"
            android:textIsSelectable="true"
            android:textSize="16sp" />
    </androidx.core.widget.NestedScrollView>

    <br.com.simplepass.loadingbutton.customViews.CircularProgressButton
        android:id="@+id/lite_about_check"
        android:layout_width="120dp"
        android:layout_height="48dp"
        android:layout_gravity="bottom|center"
        android:layout_margin="24dp"
        android:background="@drawable/lite_element_rounded_button_bg_primary"
        android:text="@string/lite_about_check_update"
        android:textColor="@color/lite_about_white"
        android:textSize="16sp"
        app:finalCornerAngle="24dp"
        app:initialCornerAngle="24dp"
        app:layout_behavior="@string/hide_bottom_view_on_scroll_behavior"
        app:spinning_bar_color="@color/lite_about_white"
        app:spinning_bar_padding="5dp"
        app:spinning_bar_width="4dp" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
