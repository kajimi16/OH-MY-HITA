<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <ImageView
        android:id="@+id/lite_timeline_empty_image"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:alpha="0.5"
        android:contentDescription="@null"
        android:src="@drawable/lite_timeline_ic_empty" />

    <TextView
        android:id="@+id/lite_timeline_empty_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/lite_timeline_empty"
        android:textColor="@color/lite_timeline_text_secondary"
        android:textSize="14sp" />
</LinearLayout>
