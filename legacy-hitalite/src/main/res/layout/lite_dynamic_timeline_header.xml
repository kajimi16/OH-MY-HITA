<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/lite_timeline_bg_card"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/lite_timeline_header_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/lite_timeline_text_secondary"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/lite_timeline_header_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@null"
            android:src="@drawable/lite_timeline_ic_empty" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/lite_timeline_header_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/lite_timeline_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/lite_timeline_header_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/lite_timeline_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/lite_timeline_header_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="12dp"
        android:max="100"
        android:progressTint="@color/lite_timeline_accent"
        android:visibility="gone" />

    <TextView
        android:id="@+id/lite_timeline_header_counting"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/lite_timeline_text_secondary"
        android:textSize="12sp" />
</LinearLayout>
