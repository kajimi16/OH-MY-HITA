<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/lite_widget_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingTop="8dp"
    android:paddingEnd="8dp"
    android:paddingBottom="6dp">

    <ImageView
        android:id="@+id/lite_widget_item_dot"
        android:layout_width="6dp"
        android:layout_height="6dp"
        android:layout_gravity="center|top"
        android:layout_marginStart="9dp"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/lite_widget_event_dot" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/lite_widget_item_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textColor="@color/lite_widget_item_name_light"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="0.5dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/lite_widget_item_clock"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_gravity="center"
                android:background="@drawable/lite_widget_ic_clock" />

            <TextView
                android:id="@+id/lite_widget_item_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="4dp"
                android:singleLine="true"
                android:textColor="@color/lite_widget_item_time_light"
                android:textSize="9sp" />
        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/lite_widget_item_place_wrap"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginTop="1dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/lite_widget_rounded_bar"
        android:clickable="false"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingTop="5dp"
        android:paddingEnd="6dp"
        android:paddingBottom="5dp">

        <ImageView
            android:id="@+id/lite_widget_item_place_icon"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:layout_gravity="center"
            android:layout_marginEnd="2dp"
            android:background="@drawable/lite_widget_ic_location"
            android:clickable="false" />

        <TextView
            android:id="@+id/lite_widget_item_place"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:alpha="0.9"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:maxEms="5"
            android:singleLine="true"
            android:textColor="@color/lite_widget_item_place_light"
            android:textSize="10sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
